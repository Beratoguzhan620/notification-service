# Copy to .env to override the local defaults used by docker compose.
POSTGRES_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
# Format: ns_<8 lowercase letters or digits>_<at least 32 letters, digits, '-' or '_'>.
# Used only to create the first admin client when there is no active admin.
ADMIN_API_KEY=ns_changeme_replace-this-with-a-long-random-secret-value
