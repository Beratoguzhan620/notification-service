{
  "ConnectionStrings": {
    "Notifications": "",
    "RabbitMq": ""
  },
  "Delivery": {
    "RetryDelays": [ "00:00:05", "00:00:30" ],
    "Prefetch": 10,
    "DeadLetterRetention": "7.00:00:00"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
